@model PontoTuristicoApp.Models.ViewModels.PontoTuristicoCreateViewModel

@{
    ViewData["Title"] = "Cadastrar Ponto Turístico";
    var estados = ViewBag.Estados as IEnumerable<PontoTuristicoApp.Models.DTOs.EstadoIbgeDto>;
    var municipios = ViewBag.Municipios as IEnumerable<PontoTuristicoApp.Models.DTOs.MunicipioIbgeDto>;
}

<div class="row justify-content-center my-4">
    <div class="col-lg-8 col-md-10">
        <div class="form-card">
            <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                <div class="d-flex align-items-center justify-content-center rounded-circle text-white" style="width: 48px; height: 48px; background-color: var(--petroleo);">
                    <i class="bi bi-geo-alt-fill fs-4"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0" style="color: var(--petroleo);">Novo Ponto Turístico</h3>
                    <p class="text-muted small mb-0">Preencha as informações para adicionar um novo destino ao Explora.</p>
                </div>
            </div>

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Nome" class="form-label">Nome do Ponto Turístico <span class="text-danger">*</span></label>
                    <input asp-for="Nome" class="form-control" placeholder="Ex: Cristo Redentor, Cataratas do Iguaçu..." />
                    <span asp-validation-for="Nome" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Descricao" class="form-label">Descrição <span class="text-danger">*</span></label>
                    <textarea asp-for="Descricao" class="form-control" rows="3" maxlength="100" placeholder="Breve resumo sobre o local (máximo de 100 caracteres)..."></textarea>
                    <div class="form-text d-flex justify-content-between">
                        <span>Apresentação curta e objetiva.</span>
                        <span class="text-muted">Máx. 100 caracteres</span>
                    </div>
                    <span asp-validation-for="Descricao" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Localizacao" class="form-label">Localização / Endereço de Referência <span class="text-danger">*</span></label>
                    <input asp-for="Localizacao" class="form-control" placeholder="Ex: Parque Nacional da Tijuca, Av. Paulista..." />
                    <span asp-validation-for="Localizacao" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-5 mb-3">
                        <label asp-for="EstadoId" class="form-label">Estado <span class="text-danger">*</span></label>
                        <select asp-for="EstadoId" class="form-select" id="EstadoId">
                            <option value="">Selecione um estado...</option>
                            @if (estados != null)
                            {
                                foreach (var est in estados)
                                {
                                    <option value="@est.Id">@est.Nome (@est.Sigla)</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="EstadoId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-7 mb-3">
                        <label asp-for="Cidade" class="form-label">Cidade <span class="text-danger">*</span></label>
                        <select asp-for="Cidade" class="form-select" id="Cidade" disabled="@(municipios == null ? "disabled" : null)">
                            @if (municipios != null && municipios.Any())
                            {
                                <option value="">Selecione uma cidade...</option>
                                foreach (var mun in municipios)
                                {
                                    if (mun.Nome == Model?.Cidade)
                                    {
                                        <option value="@mun.Nome" selected="selected">@mun.Nome</option>
                                    }
                                    else
                                    {
                                        <option value="@mun.Nome">@mun.Nome</option>
                                    }
                                }
                            }
                            else
                            {
                                <option value="">Selecione um estado primeiro</option>
                            }
                        </select>
                        <div id="cidadeLoading" class="form-text text-muted d-none align-items-center gap-1 mt-1">
                            <span class="spinner-border spinner-border-sm text-primary" role="status" aria-hidden="true"></span>
                            <span>Carregando cidades...</span>
                        </div>
                        <div id="cidadeError" class="text-danger small mt-1 d-none">
                            Não foi possível carregar as cidades. Tente novamente.
                        </div>
                        <span asp-validation-for="Cidade" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end align-items-center gap-3 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light px-4 py-2 fw-semibold" style="border: 1px solid var(--border-subtle); color: var(--grafite);">
                        Cancelar
                    </a>
                    <button type="submit" class="btn btn-coral-submit">
                        <i class="bi bi-check-lg me-1"></i> Cadastrar Ponto
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const estadoSelect = document.getElementById('EstadoId');
            const cidadeSelect = document.getElementById('Cidade');
            const loadingDiv = document.getElementById('cidadeLoading');
            const errorDiv = document.getElementById('cidadeError');

            estadoSelect.addEventListener('change', function () {
                const estadoId = this.value;

                // Reset do estado de erro e opções de cidade
                errorDiv.classList.add('d-none');
                cidadeSelect.replaceChildren();

                if (!estadoId) {
                    cidadeSelect.disabled = true;
                    loadingDiv.classList.add('d-none');
                    loadingDiv.classList.remove('d-flex');

                    const defaultOption = document.createElement('option');
                    defaultOption.value = '';
                    defaultOption.textContent = 'Selecione um estado primeiro';
                    cidadeSelect.appendChild(defaultOption);
                    return;
                }

                // Exibe loading e desabilita temporariamente o dropdown de cidade
                cidadeSelect.disabled = true;
                loadingDiv.classList.remove('d-none');
                loadingDiv.classList.add('d-flex');

                const loadingOption = document.createElement('option');
                loadingOption.value = '';
                loadingOption.textContent = 'Carregando cidades...';
                cidadeSelect.appendChild(loadingOption);

                fetch('/PontosTuristicos/MunicipiosPorEstado/' + encodeURIComponent(estadoId))
                    .then(function (response) {
                        if (!response.ok) {
                            throw new Error('Erro ao buscar municípios');
                        }
                        return response.json();
                    })
                    .then(function (municipios) {
                        cidadeSelect.replaceChildren();

                        const defaultOption = document.createElement('option');
                        defaultOption.value = '';
                        defaultOption.textContent = 'Selecione uma cidade...';
                        cidadeSelect.appendChild(defaultOption);

                        if (Array.isArray(municipios) && municipios.length > 0) {
                            municipios.forEach(function (mun) {
                                const option = document.createElement('option');
                                option.value = mun.nome;
                                option.textContent = mun.nome;
                                cidadeSelect.appendChild(option);
                            });
                            cidadeSelect.disabled = false;
                        } else {
                            defaultOption.textContent = 'Nenhum município encontrado';
                        }
                    })
                    .catch(function (error) {
                        cidadeSelect.replaceChildren();
                        const errorOption = document.createElement('option');
                        errorOption.value = '';
                        errorOption.textContent = 'Não foi possível carregar as cidades';
                        cidadeSelect.appendChild(errorOption);
                        cidadeSelect.disabled = true;
                        errorDiv.classList.remove('d-none');
                    })
                    .finally(function () {
                        loadingDiv.classList.add('d-none');
                        loadingDiv.classList.remove('d-flex');
                    });
            });
        });
    </script>
}
